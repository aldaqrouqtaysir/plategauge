{
  "name": "@plategauge/web",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:ort": "node scripts/copy-ort-assets.mjs",
    "predev": "pnpm run prepare:ort",
    "dev": "vite",
    "prebuild": "pnpm run prepare:ort",
    "build": "tsc -b && vite build",
    "build:camera": "pnpm run prepare:ort && tsc -b && vite build --mode camera-candidate",
    "preview:camera": "vite preview --outDir dist-camera --host 127.0.0.1 --port 4192 --strictPort",
    "test:camera-candidate": "playwright test --config playwright.camera-candidate.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:public-smoke": "playwright test --config playwright.public-smoke.config.ts",
    "capture:portfolio": "node scripts/capture-portfolio-assets.mjs",
    "record:demo": "node scripts/record-local-demo.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
